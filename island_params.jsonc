// Paramètres du générateur d'île.
// Convention : null = tiré de la seed. Toute valeur non-null override le tirage.
// Unités : mètres, années, degrés, °C. 1 bloc = world.block_size_m.
// Fréquences de bruit : en cycles par rayon d'île R (R = shape.radius_ratio * demi-taille de la carte).
// Coordonnées (x, y, center) : en mètres, origine au centre de la carte.
{
  "seed": 31,

  "world": {
    "width": 4096,
    "length": 4096,
    "block_size_m": 1.0,
    "chunk_size": 32,                  // chunks cubiques
    "sea_level_y": 0,                  // en blocs
    "vertical_exaggeration": 1.0       // appliqué à la voxelisation uniquement
  },

  "simulation": {
    "coarse_resolution": 1024,         // grille de l'étape 3
    "total_duration_years": null,      // [2e5, 2e6] : plus long pour une île grande (R de 500 m à 2 km) et vieille
    "dt_years": null,                  // [500, 1e4]
    "climate_update_interval_steps": 10,
    // étape 3 : chaque processus de la boucle temporelle peut être désactivé
    "processes": { "uplift": true, "climate": true, "glaciers": true, "fluvial": true, "hillslope": true, "marine": true },
    "log_interval_steps": 100,         // la simulation logue ses chiffres tous les N pas
    "boundary_depth_m": null           // fond océanique imposé au bord [-1500, -200] ; limité pour que la pente du talus tienne dans la carte
  },

  "origin": {
    "type": null,                      // "volcanic" | "continental" | "sedimentary" | "coral"
    "type_weights": { "volcanic": 0.25, "continental": 0.45, "sedimentary": 0.2, "coral": 0.1 },
    "age": null                        // [0,1] 0 = jeune/vif, 1 = vieux/usé ; module durée et uplift
  },

  // Les distributions de forme dépendent de origin.type (volcanique / continentale / sédimentaire / corallienne).
  "shape": {
    "mode": null,                      // "blobs" (lobes) | "ring" (atoll) ; corallienne : ring, autres : blobs
    "radius_ratio": null,              // demi-longueur de l'île / demi-taille de la carte [0.4, 0.8]
    "lobe_count": null,                // volc. 1-2, cont. 2-5, séd. 2-4, cor. 1
    "lobe_spread": null,               // dispersion des centres : volc. [0, 0.3], cont. [0.4, 0.9], séd. [0.2, 0.5], cor. [0, 0.2]
    "lobe_radius_min": null,           // rayon moyen d'un lobe tiré dans [min, max] * R ; min [0.25, 0.6]
    "lobe_radius_max": null,           // min + [0.1, 0.5], au plus 1 ; petits lobes = presqu'îles, gros = une seule masse
    "lobe_elongation_max": null,       // lobes elliptiques : allongement de chaque lobe dans [1, max] ; max cont. [1, 2], autres [1, 1.5]
    "lobe_alignment": null,            // [0, 1] : 0 = lobes orientés au hasard, 1 = tous alignés sur l'axe ; séd. [0.8, 1]
    "main_axis_deg": null,             // axe principal [0, 180] ; sert aussi d'axe à la 1re phase "collision" et aux plis (île continentale)
    "elongation": null,                // >= 1, étirement de toute la forme le long de l'axe :
                                       // volc. [1, 1.3], cont. 60 % [1.5, 2.5] / 40 % [1, 1.5], séd. [3, 8], cor. [1, 1.5]
    "lobe_blend": null,                // [0, 0.3] * R : union adoucie des lobes (comble les creux entre eux)
    "bay_count": null,                 // lobes soustractifs (baies). P(0/1/2) : cont. 50/35/15 %, volc. 70/30/0, séd. 85/15/0, cor. 100/0/0
    "bay_radius_min": 0.15,            // rayon d'une baie dans [min, max] * R
    "bay_radius_max": 0.35,
    "bay_penetration": null,           // [0.3, 0.8] : 0 = la baie effleure la côte, 1 = centrée dans les terres
    // mode "ring" : un récif annulaire suit le contour de la forme, autour d'un lagon
    "ring_width_m": null,              // largeur moyenne de l'anneau [80, 250]
    "ring_width_noise": null,          // variation relative de la largeur [0.3, 0.8]
    "ring_noise_frequency": null,      // fréquence des passes et de la variation de largeur, en cycles par rayon [1.5, 4]
    "ring_noise_octaves": null,        // octaves de ce bruit [1, 3] : peu d'octaves = quelques passes larges
    "ring_offset_m": null,             // retrait de l'axe de l'anneau vers l'intérieur du contour ; [0.5, 1] * ring_width_m
    "ring_pass_fraction": null,        // part de l'anneau coupée par des passes (entre les motus) [0.05, 0.3]
    // domain warp ; amplitude relative à la demi-largeur de l'île (R / elongation) :
    // volc. [0.05, 0.15], cont. et séd. [0.1, 0.3], cor. [0.02, 0.06]
    "noise": { "frequency": null, "amplitude": null, "octaves": null, "lacunarity": 2.0, "gain": 0.5 },
    "coast_falloff_m": null,           // largeur de la transition terre/mer du masque
    "shelf_width_m": null,             // plateau [10, 1500], part de la mer libre entre l'île et le bord :
                                       // volc. 3-10 %, cont. 10-35 %, séd. 30-60 % ; cor. : platier de 10 à 50 m
    "shelf_depth_m": null,             // volc. [-40, -10], cont. [-60, -10], séd. [-15, -3], cor. [-15, -5]
    "talus_slope_deg": null,           // pente du fond jusqu'à boundary_depth_m : volc. [15, 30], cont. [8, 20], séd. [3, 10], cor. [35, 50]
    "talus_width_m": null,             // largeur de cette pente ; dérivée : (shelf_depth_m - boundary_depth_m) / tan(talus_slope_deg)
    "seafloor_noise": { "frequency": null, "amplitude_m": null }, // léger relief du fond au-delà du plateau
    "keep_satellite_islets": true,
    "min_islet_area_m2": 2000
  },

  // Le relief initial dépend de l'origine ; tailles relatives à l'île pour garder des proportions physiques.
  "initial_topography": {
    "mode": null,                      // "flat" | "peneplain" | "noise" | "volcanic_cone" | "atoll" | "barrier"
                                       // volc. : volcanic_cone, cont. : peneplain ou noise, séd. : barrier, cor. : atoll
    "base_elevation_m": null,          // volcanic_cone [0, 30] (plateau sous les cônes), barrier [1, 3],
                                       // peneplain / noise / flat : 10 + 290 u² (basse le plus souvent), atoll : 0
    "noise": { "frequency": null, "amplitude_m": null, "octaves": null, "lacunarity": 2.0, "gain": 0.5 },
                                       // amplitude : peneplain [5, 40], barrier [0.3, 1.5], autres [10, 200]
    // Pas de terrain plat au départ (un plat s'écoule en lignes droites parallèles) :
    "regional_dome_m": null,           // bombement de la côte vers l'intérieur : volc. [5, 15], cont. [10, 30],
                                       // séd. [5, 15], cor. [5, 10] ; pas appliqué aux modes atoll et barrier
    "roughness_m": null,               // rugosité multi-échelles (fBm) : atoll et barrier [0.5, 1],
                                       // sinon volc. [3, 8], cont. [4, 10], séd. [2, 6], cor. [2, 4]
    "roughness_frequency": null,       // cycles par rayon d'île [4, 8]
    "roughness_octaves": null,         // [4, 6]
    "volcano": {
      "count": null,                   // [1, 3]
      "radius_m": null,                // rayon maximal [0.6, 1] * R ; un volcan est réduit (avec sa hauteur et son cratère)
                                       // pour que son pied arrive à la côte la plus proche de sa cheminée
      "height_m": null,                // [0.15, 0.45] * radius_m (flancs de quelques dizaines de degrés)
      "profile_exponent": null,        // forme du cône [1, 3] : h = height * (1 - r / radius)^exposant
      "flank_noise_frequency": null,   // relief irrégulier des flancs (dévie aussi les coulées), en cycles par rayon [4, 10]
      "flank_noise_octaves": null,     // [2, 3]
      "flank_noise_m": null,           // amplitude ; [0.03, 0.08] * R / flank_noise_frequency (pente bornée)
      "crater_radius_m": null,         // [0.05, 0.15] * radius_m
      "crater_depth_m": null,          // dérivé de height_m (5 à 15 %)
      "min_spacing_m": null,           // distance minimale entre cheminées ; [0.5, 1.2] * radius_m. Les cheminées sont
                                       // tirées dans la moitié intérieure de l'île (distance à la côte >= moitié du maximum)
      "caldera": null,                 // bool ; probabilité 0.2 + 0.4 * origin.age (au lieu du cratère)
      "caldera_radius_m": null,        // [0.15, 0.3] * radius_m
      "caldera_rim_width_m": null,     // largeur de la paroi de la caldeira ; [0.1, 0.3] * caldera_radius_m
      "caldera_depth_m": null,         // [0.1, 0.3] * height_m
      "lava_flow_count": null,         // coulées par volcan [0, 8]
      "lava_flow_height_m": null,      // hauteur de la bosse laissée par une coulée [5, 15]
      "lava_flow_width_m": null,       // largeur de la coulée [10, 40]
      "lava_flow_turn_deg": null,      // écart aléatoire à la plus grande pente, à chaque pas [10, 40]
      "lava_flow_min_slope_deg": null  // la coulée s'arrête sur une pente plus faible (ou en mer) [1, 3]
    },
    "atoll": {
      "makatea": null,                 // atoll soulevé à falaises ; probabilité 0.15
      "ring_height_m": null,           // hauteur de l'anneau : [1, 4], ou [30, 60] si makatea
      "ring_noise_m": null,            // relief de l'anneau ; [0.1, 0.3] * ring_height_m
      "lagoon_depth_m": null,          // profondeur du lagon [5, 40]
      "lagoon_noise_m": null,          // relief du fond du lagon ; [0.05, 0.2] * lagoon_depth_m
      "pinnacle_count": null,          // pinacles coralliens dans le lagon [3, 15]
      "pinnacle_radius_m": null,       // [10, 40]
      "pinnacle_top_depth_m": null     // les pinacles remontent jusqu'à cette profondeur [1, 2]
    },
    "barrier": {
      "crest_height_m": null           // crête basse le long de l'île, maximale au milieu de la largeur [1, 5]
    }
  },

  "geology": {
    "materials": {
      // hardness [0,1] ; erodibility = multiplicateur de K ; talus en degrés ; sediment = grain produit
      "basalt":    { "hardness": 0.80, "erodibility": 0.6, "talus_angle_deg": 45, "sediment": "gravel" },
      "granite":   { "hardness": 0.90, "erodibility": 0.4, "talus_angle_deg": 50, "sediment": "sand" },
      "gneiss":    { "hardness": 0.85, "erodibility": 0.5, "talus_angle_deg": 48, "sediment": "sand" },
      "schist":    { "hardness": 0.50, "erodibility": 1.2, "talus_angle_deg": 38, "sediment": "clay" },
      "limestone": { "hardness": 0.60, "erodibility": 1.0, "talus_angle_deg": 55, "sediment": "clay" },
      "sandstone": { "hardness": 0.45, "erodibility": 1.3, "talus_angle_deg": 42, "sediment": "sand" },
      "shale":     { "hardness": 0.25, "erodibility": 2.0, "talus_angle_deg": 30, "sediment": "clay" },
      "tuff":      { "hardness": 0.30, "erodibility": 1.8, "talus_angle_deg": 35, "sediment": "sand" }
    },
    "strata": null,                    // [{ "material": "limestone", "thickness_m": 40 }, ...] de haut en bas
    "strata_count": null,              // [3, 12]
    "strata_top_m": null,              // altitude du sommet de la pile
    "basement_material": null,         // matériau sous la pile
    "folding": {
      "enabled": null,
      "axis_angle_deg": null,
      "wavelength_m": null,            // [0.4, 1.5] * R
      "amplitude_m": null,             // [0.03, 0.2] * wavelength_m
      "asymmetry": null,               // [0,1] plis déversés
      "plunge_deg": null
    },
    "faults": null,                    // [{ "x": .., "y": .., "angle_deg": .., "length_m": .., "dip_deg": .., "offset_m": .. }]
                                       // trace centrée sur (x, y) ; le côté à gauche de la direction angle_deg monte de offset_m
    "fault_count": null,
    "fault_tip_taper": null,           // le décalage d'une faille s'atténue sur cette fraction de sa demi-longueur [0.1, 0.4]
    "intrusions": null,                // [{ "material": "granite", "x": .., "y": .., "radius_m": .., "top_m": .., "dome_k": 0.5 }]
                                       // cloches (paraboloïdes) testées avant les strates : sous le sommet top_m, le toit descend
                                       // de dome_k * radius_m à radius_m de l'axe et continue de s'élargir en profondeur.
                                       // Matériau : basalte (volcanique), granite surtout (autres). top_m : volc. [-200, 50],
                                       // cont. [-100, 300] (peut affleurer), séd. et cor. [-300, 0] ; cont. : dans la zone de la collision
    "intrusion_count": null
  },

  // Tectonique par origine : volcanique = 0 ou 1 dôme faible ; sédimentaire et corallienne = 0 ou 1 subsidence
  // faible (plafonnée : au plus 50 % de l'altitude moyenne initiale de l'île) ; continentale = 1 à 4 phases,
  // collision 40 %, dome 30 %, tilt 10 %, block_uplift 10 %, horst_graben 10 %, jamais de subsidence (sauf forcée).
  // Seuls les motifs spatiaux sont calculés à l'étape 2.
  // Contrôle après tirage : si le soulèvement total moyen sur l'île est négatif (au-delà de la subsidence
  // permise), la phase qui l'abaisse le plus est retirée (jamais une phase dont le type est forcé) ; c'est logué.
  "tectonics": {
    "phases": null,
    // [{ "type": "collision" | "dome" | "horst_graben" | "block_uplift" | "tilt" | "subsidence",
    //    "start_years": .., "end_years": .., "rate_m_per_year": .. (>= 0 ; le motif porte le signe),
    //    "center": [x, y], "angle_deg": .., "length_m": .., "width_m": ..
    //    (longueur et largeur au plus 1.2 fois le diamètre de l'île dans leur direction),
    //    "falloff": .. (largeur des bords, fraction de la demi-taille : [0.2, 0.35] pour block_uplift et
    //                   horst_graben, soit au moins 10 % de la largeur ; [0.2, 1] sinon),
    //    "fault_dip_deg": .. (pendage des failles générées pour block_uplift et horst_graben [55, 80]),
    //    "negative_factor": 0.3 (tilt et horst_graben : échelle de la partie abaissée du motif) }]
    // Les phases block_uplift et horst_graben génèrent des failles le long de leurs bords : la géologie suit
    // le contour déformé du motif ; geology.derived_faults (toujours recalculées) en donne les traces nominales.
    "phase_count": null,
    // Le relief d'équilibre des rivières vaut environ 10 m * (U / k_base) * P^-m (wgen --calibrate) : le taux
    // max est déduit d'un relief cible, pour que soulèvement et érosion restent du même ordre.
    "target_relief_m": null,           // cont. log [150, 1500], volc. 50-100 % de la hauteur du cône, séd. et cor. [5, 30]
    "max_uplift_rate_m_per_year": null, // target_relief_m * max(k_base * P^m / 10, 1 / durée), borné à [1e-5, 1e-2]
    "ongoing_uplift": null,            // cont. : 75 %, volc. : 1 - âge ; la dernière phase de soulèvement (collision, dome,
                                       // block_uplift) commence dans le 1er cinquième et dure jusqu'à la fin ; sinon île « vieille »
    // Tous les motifs sont déformés (pas de bord ni d'axe rectiligne) et modulés (jamais uniformes) :
    "uplift_warp_amplitude": null,      // domain warp, relatif au rayon de l'île [0.1, 0.25]
    "uplift_warp_frequency": null,      // cycles par rayon d'île [0.7, 1.5]
    "uplift_modulation": null,          // motif * lerp(1 - modulation, 1, bruit) [0.3, 0.6]
    "uplift_modulation_frequency": 2.0  // cycles par rayon d'île
  },

  "climate": {
    "base_temperature_c": null,        // au niveau de la mer [-10, 30]
    "lapse_rate_c_per_km": 6.5,
    "humidity": null,                  // [0,1]
    "base_precipitation_m_per_year": null,
    "wind": { "direction_deg": null, "strength": null, "variability_deg": null },
    "swell": { "direction_deg": null, "energy": null },
    // Précipitations orographiques (advection de l'humidité le long du vent) ; les taux sont par km parcouru,
    // par km de montée ou par km de mer, donc indépendants de la grille.
    "orographic": {
      "condensation_rate": null,         // part de l'humidité qui tombe par km de montée [0.2, 1]
      "rain_shadow_strength": null,      // réservé : l'ombre pluviométrique vient de l'épuisement de l'humidité
      "moisture_recharge_over_sea": null, // relaxation de l'humidité vers la saturation, par km de mer [0.05, 0.5]
      "q0": 1.0,                         // échelle de saturation : q_sat = q0 * exp(0.07 * T)
      "base_rate": null                  // part de l'humidité qui tombe par km parcouru, sans relief [0.02, 0.1]
    }
  },

  "timeline": {
    "sea_level_curve": null,           // [{ "t_years": .., "level_m": .. }] interpolé linéairement
    "glaciations": null,               // [{ "start_years": .., "end_years": .., "temperature_offset_c": .. }]
    "glaciation_count": null
  },

  "erosion": {
    "fluvial": {
      "k_base": null,                  // [1e-6, 1e-4]
      "m": 0.45,
      "n": 1.0,
      "deposition_g": null,            // coefficient de dépôt (Yuan 2019) [0, 2]
      "precipitation_weighted": true,
      "k_sediment_mult": 5,              // K sur les sédiments = k_base * k_sediment_mult ; sur la roche : k_base * erodibility
      "deposition_tolerance": 1e-3,      // Gauss-Seidel sur le flux de sédiments : variation relative (L1) où s'arrêter
      "deposition_max_iterations": 20
    },
    // Diffusion marine des sédiments (Yuan et al. 2019, EPSL) : D(z) = d0 * exp(-profondeur / depth_scale_m),
    // en m²/an, par classe de grains : gravier et sable (sand_d0), argile (fines_d0, plus mobile).
    // Valeurs ramenées à l'échelle de ces cartes (quelques km) : D varie comme le carré des longueurs.
    "marine_diffusion": {
      "sand_d0": null,                   // log [0.05, 1]
      "fines_d0": null,                  // sand_d0 * [5, 20]
      "depth_scale_m": null,             // [15, 60]
      "mobile_layer_m": 1                // flux sortant * min(1, sédiment / mobile_layer_m) : une pellicule ne file pas
    },
    "hillslope": { "diffusivity_m2_per_year": null },  // [1e-3, 1e-1], diffusion implicite (ADI) sur la terre
    "thermal": {
      "iterations_per_step": 1,
      "rate": null,                      // part de l'excès de hauteur déplacée par passe (défaut 0.5 : la moitié)
      "sediment_talus_angle_deg": 33     // angle de repos des sédiments ; la roche utilise talus_angle_deg de son matériau
    },
    // Glaciers : écoulement SIA (Jarosch et al. 2013) sur une grille grossière, relaxé à l'équilibre à chaque mise à
    // jour du climat ; érosion de Harbor (1992) à chaque pas ; moraines au front.
    "glacial": {
      "accumulation_rate": null,       // part des chutes de neige qui devient glace [0.5, 1.5]
      "ablation_gradient": null,       // m de glace fondue par an et par °C au-dessus de 0 [0.3, 1.5]
      "sliding_coeff": null,           // u_s = sliding_coeff * tau_b² (m/an/Pa²) log [5e-10, 1e-8]
      "erosion_coeff": null,           // érosion = erosion_coeff * u_s^erosion_exponent log [5e-6, 5e-5] (~1 mm/an à 50 m/an)
      "erosion_exponent": 1.0,
      "glen_A": 2.4e-24,               // facteur de la loi de Glen (Pa⁻³ s⁻¹), converti en années dans le code
      "ice_density": 917,              // kg/m³
      "snow_temperature_c": 0,         // il neige en dessous
      "max_substeps": 5000,            // sous-pas au plus par relaxation de la glace
      "convergence_tol": 0.01,         // relaxée quand |dH/dt| moyen < tol (m/an)
      "ice_threshold_m": 5,            // plus épaisse : pas de rivières ni de versants ; plus mince : les moraines tombent
      "calving_depth_m": 30,           // la glace vêle sur une eau plus profonde
      "ice_grid_cell_m": 50            // maille de la grille de la glace (le SIA explicite est impossible à 4 m)
    },
    // Croissance récifale (îles coralliennes) : le récif suit le niveau marin (Darwin).
    "reef": {
      "enabled": true,
      "growth_rate": null,             // m/an log [2e-3, 1e-2]
      "max_depth": null                // croît entre cette profondeur et la surface [10, 30]
    },
    "coastal": {
      "wave_erosion_coeff": null,        // m² de section de falaise par an et par m de côte (expo., énergie et dureté 1) log [0.01, 1]
      "fetch_ray_count": 32,
      "fetch_max_distance_m": null,      // [2000, 20000]
      "platform_depth_m": null,          // plateforme d'abrasion sous le niveau marin [3, 15]
      "sediment_export_threshold": null, // énergie * exposition au-dessus de laquelle les débris partent au large [0.3, 0.9]
      "exposure_update_interval_steps": 10, // l'exposition (rayons de fetch) est recalculée tous les N pas
      "platform_attenuation_m": 200,     // la houle s'amortit en exp(-largeur des petits fonds / ceci) : le recul ralentit
      "sediment_hardness": 0.1           // dureté d'une couverture de sédiments face aux vagues
    },
    "detail_hydraulic": {
      "method": "droplet",             // "droplet" | "pipe"
      "droplet_count": null,
      "inertia": 0.05,
      "capacity": 4.0,
      "erosion_rate": 0.3,
      "deposition_rate": 0.3,
      "evaporation": 0.01,
      "radius": 3,
      "max_lifetime": 64
    },
    "aeolian": {
      "enabled": null,
      "sand_supply": null,
      "iterations": null,
      "slab_height_m": 0.2,
      "hop_length_m": null,
      "deposit_prob_sand": 0.6,
      "deposit_prob_bare": 0.4,
      "repose_angle_deg": 34,
      "shadow_angle_deg": 15
    }
  },

  // Multiplicateurs des coefficients de chaque processus, par origine (l'île utilise ceux de son origine).
  // fluvial : k_base ; hillslope : diffusivité ; thermal : taux d'effondrement ; marine : érosion par les vagues ;
  // marine_diffusion : diffusivités marines ; glacial : érosion glaciaire.
  "process_multipliers": {
    "volcanic":    { "fluvial": 1.0,  "hillslope": 1, "thermal": 1, "marine": 1.0, "marine_diffusion": 1, "glacial": 1 },
    "continental": { "fluvial": 1.0,  "hillslope": 1, "thermal": 1, "marine": 1.0, "marine_diffusion": 1, "glacial": 1 },
    "sedimentary": { "fluvial": 0.5,  "hillslope": 0.2, "thermal": 1, "marine": 1.5, "marine_diffusion": 2, "glacial": 1 },
